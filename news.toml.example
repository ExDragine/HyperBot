[news]
enabled = true
board = "general"
timezone = "Asia/Shanghai"

# 主 Agent 加载每日新闻技能，并按这些主题和时间窗口检索。
queries = ["中国 今日 主要新闻", "全球 今日 主要新闻", "科技 最新消息", "经济 社会 最新消息"]
window_hours = 24
min_stories = 3
target_stories = 14

generation_timeout = 300
render_timeout = 30
send_timeout = 30
max_generation_attempts = 3
retention_days = 30

# bot_id 留空时使用当前默认机器人。
bot_id = ""
