config_version = 2

# 填写启动所用的模型、密钥和 Dashboard 密码。其余选项见 docs/configuration.md。
[bot]
system_prompt = "你是 {name}，一个友好的 QQ 聊天机器人。"

[models]
advanced_model = "" # 主对话模型
basic_model = ""    # 辅助任务模型
paint_model = "gpt-image-2.6-flare"

# 内置供应商已有接口协议。仅在使用代理或需要改协议时覆盖。
[providers.openai]
api_key = ""

# 默认 Decision 模型使用 DeepSeek。
[providers.deepseek]
api_key = ""

[dashboard]
password = "admin" # 初次部署时设置自己的密码
