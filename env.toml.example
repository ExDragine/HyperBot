# HyperBot 完整配置示例。启动前填写主辅模型、所用供应商的密钥和 Dashboard 密码。
# 其余配置可按默认值使用。字段、取值范围和运行时行为见 docs/configuration.md。
#
# 以下变量通过 .env 或进程环境设置，在这里列出供查阅。
# NoneBot 启动：ENVIRONMENT、DRIVER、HOST、PORT、LOG_LEVEL、SUPERUSERS、
# NICKNAME、COMMAND_START、SESSION_EXPIRE_TIMEOUT。示例见 .env.example。
# FRONTIER_CONFIG = "env.toml"            # HyperBot 配置文件路径
# FRONTIER_NEWS_CONFIG = "news.toml"      # 日报插件配置文件路径
# FRONTIER_NEWS_DB = "news.db"           # 日报归档数据库路径
# OPENAI_API_BASE = ""                   # OpenAI profile 未填 base_url 时优先读取
# OPENAI_BASE_URL = ""                   # OPENAI_API_BASE 之后读取

config_version = 2

[bot]
system_prompt = "你是 {name}，一个友好的 QQ 聊天机器人。"

[models]
# 供应商留空时按模型名推断，能力可填写 text、vision、audio、video、file。
advanced_model = ""
advanced_model_provider = ""
advanced_model_capabilities = []
advanced_reasoning_effort = "" # Responses 留空时使用 [agent].reasoning_effort

basic_model = ""
basic_model_provider = ""
basic_model_capabilities = []
basic_reasoning_effort = "" # 留空时使用供应商默认值

decision_model = "deepseek-flash"
decision_model_provider = "deepseek"
decision_model_capabilities = ["text"]

# 兼容旧日报模型设置。当前日报使用主模型。
daily_news_model = "deepseek-flash"
daily_news_model_provider = "deepseek_responses"
daily_news_model_capabilities = ["text"]

paint_model = "gpt-image-2.6-flare"
paint_model_provider = "openai"
paint_size = "auto" # 当前绘图请求固定使用 auto
paint_quality = "auto"

video_model = "" # 使用支持 Videos API 的兼容网关时填写
video_model_provider = "openai"
video_size = "1280x720"
video_seconds = "8"

# 内置供应商及其默认协议。使用兼容网关时可另建 [providers.<name>]。
[providers.openai]
type = "openai"
api_mode = "responses"
base_url = "" # 留空时按环境变量和官方默认地址解析
api_key = ""
# 省略两个原生检索开关时按实际路由和模型能力判断。兼容 Responses 网关用 true 显式开启。
# native_web_search = false
# native_tool_search = false
responses_store = false
native_decisions = false # 启用时还需设置官方密钥及 decision_model = "gpt-6-luna"
structured_output_method = "auto"
decision_extra_body = {}
# 旧名 signal_extra_body 仍可读取，新配置使用 decision_extra_body。

[providers.deepseek]
type = "deepseek"
api_mode = "chat_completions"
# base_url = "" # 省略时使用适配器默认地址
api_key = ""
safety_check = { level = "high" }
# title = { enabled = true }

[providers.deepseek_responses]
type = "openai"
api_mode = "responses"
base_url = "https://api.deepseek.com"
api_key = ""
safety_check = { level = "high" }

[providers.deepseek_anthropic]
type = "anthropic"
api_mode = "messages"
base_url = "https://api.deepseek.com/anthropic"
api_key = ""
safety_check = { level = "high" }

[providers.google]
type = "google"
api_mode = "generate_content"
# base_url = "" # 省略时使用适配器默认地址
api_key = ""

[providers.anthropic]
type = "anthropic"
api_mode = "messages"
# base_url = "" # 省略时使用适配器默认地址
api_key = ""

[key]
nasa_api_key = "DEMO_KEY"
github_pat = ""

[features]
agent_enabled = true
paint_enabled = true
# video_enabled = true # 省略时跟随 paint_enabled
# qq_text_canary_enabled = false # 仅为旧配置兼容

[agent]
reasoning_effort = "medium" # 主模型走 Responses 且未配置独立思考强度时使用
message_image_text_threshold = 500
message_media_fake_ip_fallback = true

[search]
enabled = true
provider = "deepseek_responses"
base_url = "https://api.deepseek.com"
model = "deepseek-flash"
timeout_seconds = 30.0
content_preview_chars = 6000
max_content_chars = 24000

[document_parsing]
enabled = true
credentials_profile = "deepseek"
purpose = "text_recognition" # 也可选 rich_layout_recognition
max_files_per_message = 3
max_file_bytes = 104_857_600 # 100 MiB
max_text_chars = 30_000
timeout_seconds = 180

[speech_recognition]
enabled = false
credentials_profile = "deepseek"
timeout_seconds = 120
max_audio_seconds = 120
max_audio_bytes = 10_485_760 # 10 MiB
max_audio_per_message = 3
max_transcript_chars = 8000

[speech_synthesis]
enabled = false
credentials_profile = "deepseek"
voice_id = "stella" # 也可选 tide
timeout_seconds = 180
max_text_chars = 300
max_audio_seconds = 60
rate_limit_max_requests = 3
rate_limit_window_seconds = 600

[agent_policy]
whitelist_mode = false
whitelist_person_list = []
whitelist_group_list = []
blacklist_person_list = []
blacklist_group_list = []

[auto_reply_policy]
whitelist_mode = false
whitelist_group_list = []
blacklist_group_list = []

[paint_policy]
whitelist_mode = false
whitelist_person_list = []
whitelist_group_list = []
blacklist_person_list = []
blacklist_group_list = []

[limits]
paint_rate_limit_max_requests = 3
paint_rate_limit_window_seconds = 600
video_rate_limit_max_requests = 1
video_rate_limit_window_seconds = 900
video_poll_interval_seconds = 15
video_poll_timeout_seconds = 900
agent_llm_timeout_seconds = 900
agent_job_timeout_seconds = 3600
agent_model_call_limit = 20
agent_tool_call_limit = 40

[sessions]
history_max_tokens = 32_000
history_window_fraction = 0.25

[events]
enabled = true
workers = 2
timeout_seconds = 30
ttl_seconds = 3600
max_pending = 1000
retention_days = 30

[events.rules]
# 事件类型可用 friend_request、group_join_request、group_invited_join_request、group_invitation。
# [events.rules.friend_request]
# mode = "record" # 可选 ignore、record、rule、shadow、decision
# actions = ["defer"] # 可包含 accept、reject、defer
# action = "defer"
# instructions = "信息不足时选择 defer。"
# initiator_ids = []
# allow_filtered = false

[events.groups]
# 可用 [events.groups."<群号>".group_join_request] 等表完整覆盖该群的对应全局规则，字段同上。

[notifications]
# 内置任务、维护通知和地震预警的初始推送群。
test_group_id = []
announce_group_id = []
apod_group_id = []
earth_now_group_id = []
news_summary_group_id = []
earthquake_group_id = []
nrc_merchant_group_id = []

[storage]
query_message_numbers = 100
image_enabled = true
image_ttl_days = 30
# media_ttl_days = 30 # 省略时跟随 image_ttl_days
max_inline_images = 4
max_inline_media_bytes = 20_971_520 # 20 MiB
image_auto_cleanup = true

[debug]
agent_debug_mode = false

[dashboard]
password = "admin" # 初次部署时设置自己的密码
# jwt_secret = "" # 省略时生成本地运行时密钥
jwt_expire_hours = 24
